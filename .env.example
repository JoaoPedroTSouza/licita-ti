# ===== Acesso =====
# Senha que você digita no app (uso pessoal, um usuário). Troque: o valor de exemplo impede a inicialização.
APP_PASSWORD=troque-esta-senha
# Mínimo de 32 caracteres. Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-este-segredo

POSTGRES_PASSWORD=licita

# ===== IA (classificação e resumo) =====
# Sem chave, nenhuma oportunidade é avaliada nem aparece na Entrada.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_MAX_POR_EXECUCAO=60

# ===== Fontes =====
# ReliefWeb: não implementado; ver docs/fontes/reliefweb.md (a API exige appname aprovado).
RELIEFWEB_APPNAME=

# ===== Arquivos anexados =====
# Pasta (volume) onde ficam os anexos dos processos e o tamanho máximo por arquivo
ARQUIVOS_DIR=/data/arquivos
ARQUIVO_MAX_MB=20

# ===== Web Push =====
# Gere com: docker compose run --rm api python -m radar.interfaces.gen_vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# ===== Agendamento (horário de Brasília) =====
COLETA_HORARIOS=7,12,18

# ===== Produção =====
# Domínio apontando para o servidor (usado pelo Caddy para emitir HTTPS)
DOMAIN=radar.seudominio.com.br
APP_URL=https://radar.seudominio.com.br
